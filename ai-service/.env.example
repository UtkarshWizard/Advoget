PORT=8000
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INTERNAL_API_KEY=change-me-shared-internal-secret
OPENROUTER_API_KEY=sk-or-v1-your-key

# Do not hardcode model IDs in code; configure tool-capable OpenRouter models here:
MODEL_GATE=
MODEL_CHAT=
MODEL_FALLBACKS=

# Embeddings: 'openrouter' or 'local'
EMBEDDINGS_PROVIDER=openrouter
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBED_DIM=1024

# Web search (Tavily)
TAVILY_API_KEY=tvly-your-key
DAILY_WEB_SEARCH_CAP=10

